# Neon: cadena de conexión "pooled" (host con -pooler) para la aplicación
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/farmacias?sslmode=require"
# Neon: conexión directa (sin -pooler) para las migraciones de Prisma
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/farmacias?sslmode=require"

# Dominios del frontend permitidos por CORS, separados por coma.
# En desarrollo (NODE_ENV distinto de production) se agrega localhost:5173 automáticamente.
CORS_ORIGINS="https://tu-frontend.vercel.app"

PORT=3000
