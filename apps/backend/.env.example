# Neon: cadena de conexión "pooled" (host con -pooler) para la aplicación
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Neon: conexión directa (sin -pooler) para las migraciones de Prisma
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Opcional. Dominios extra permitidos por CORS, separados por coma. Con Vercel Services
# el frontend está en el mismo dominio y no lo necesita. En desarrollo se agrega localhost:5173.
CORS_ORIGINS=""

PORT=3000
